<Window x:Class="TallyAgent.Manager.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Configuration" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <GroupBox Header="Tally" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Host" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Company name" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompanyBox" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="Extraction start date" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBox x:Name="StartDateBox" Margin="0,2"
                             ToolTip="yyyy-MM-dd"/>
                    <!-- Shown only when the full-history walk has already
                         completed, which is exactly when this field stops doing
                         anything. Hidden otherwise so it never becomes noise. -->
                    <TextBlock x:Name="StartDateInertText" Visibility="Collapsed"
                               TextWrapping="Wrap" FontSize="11" Foreground="#A4262C"
                               Margin="0,2,0,4"
                               Text="Has no effect right now — the full history sync has already finished, and this date is only read while it is still running. Change it and Save, and you will be asked whether to re-extract all history."/>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Extraction end date" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="EndDateBox" Margin="0,2"
                         ToolTip="yyyy-MM-dd. Leave BLANK on the machine that tracks live data.&#x0a;Set it with the start date to back-fill one financial year at a time,&#x0a;e.g. start 2019-04-01 and end 2020-03-31."/>
                <TextBlock Grid.Row="5" Text="Sync frequency (min)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="FrequencyBox" Margin="0,2"/>
                <TextBlock Grid.Row="6" Text="Lookback days" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="LookbackBox" Margin="0,2"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="What to extract" Padding="8" Margin="0,8,0,0">
            <WrapPanel>
                <CheckBox x:Name="MastersCheck" Content="Masters" Margin="0,0,14,0"
                          ToolTip="Ledgers, groups, stock items, units, voucher types."/>
                <CheckBox x:Name="VouchersCheck" Content="Transactions" Margin="0,0,14,0"
                          ToolTip="Vouchers and their lines, allocations and inventory entries."/>
                <CheckBox x:Name="InventoryCheck" Content="Inventory" Margin="0,0,14,0"/>
                <CheckBox x:Name="GstCheck" Content="GST" Margin="0,0,14,0"/>
                <CheckBox x:Name="CostCentresCheck" Content="Cost centres" Margin="0,0,14,0"/>
                <CheckBox x:Name="AutoDiscoverCheck" Content="Auto-discover company"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Header="Reports — each one asks Tally to compute" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="SnapshotsCheck" Content="Extract reports at all"
                          FontWeight="Bold" Margin="0,0,0,6"
                          ToolTip="Master switch. Unticking this turns off every report below."/>

                <CheckBox x:Name="TrialBalanceCheck" Content="Trial Balance" Margin="16,3,0,0"/>
                <TextBlock Text="Used nightly to prove our figures match Tally's own."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <CheckBox x:Name="OutstandingPayablesCheck" Content="Outstanding Payables" Margin="16,3,0,0"/>
                <TextBlock Text="What we owe suppliers, bill by bill. Needed for AP ageing."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <CheckBox x:Name="OutstandingReceivablesCheck" Content="Outstanding Receivables" Margin="16,3,0,0"/>
                <TextBlock Text="What customers owe us, as a balance per party."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <TextBlock TextWrapping="Wrap" Margin="34,0,0,8" Foreground="Gray" FontSize="11"
                           Text="Bill-by-bill outstandings are no longer requested from Tally. They are derived downstream from the bill allocations already extracted with every voucher, which is cheaper and cannot stall Tally."/>

                <CheckBox x:Name="BalanceSheetCheck" Content="Balance Sheet  — known to freeze Tally"
                          Foreground="#A4262C" Margin="16,3,0,0"/>
                <TextBlock Text="Recommended OFF — calculated in BigQuery from ledgers and groups."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <CheckBox x:Name="ProfitLossCheck" Content="Profit and Loss  — known to freeze Tally"
                          Foreground="#A4262C" Margin="16,3,0,0"/>
                <TextBlock Text="Recommended OFF — calculated in BigQuery from vouchers."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <CheckBox x:Name="StockSummaryCheck" Content="Stock Summary  — known to freeze Tally"
                          Foreground="#A4262C" Margin="16,3,0,0"/>
                <TextBlock Text="Recommended OFF — calculated in BigQuery from inventory entries."
                           Margin="34,0,0,4" Foreground="Gray" FontSize="11"/>

                <Border Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="1"
                        Padding="8" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#444444"
                               Text="Reports run once a day after 8pm, never during office hours. The three marked above make Tally compute across the whole company and have been observed to stop it responding until it is force-closed."/>
                </Border>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Cloud" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ingestion API URL" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiUrlBox" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Agent ID" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AgentIdBox" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Company ID" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompanyIdBox" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="API token" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="TokenBox" Margin="0,2"
                             ToolTip="Leave blank to keep the existing token"/>
                <TextBlock Grid.Row="4" Text="Environment" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="EnvironmentCombo" Margin="0,2">
                    <ComboBoxItem>Development</ComboBoxItem>
                    <ComboBoxItem>Testing</ComboBoxItem>
                    <ComboBoxItem>Production</ComboBoxItem>
                </ComboBox>
            </Grid>
        </GroupBox>

        <GroupBox Header="Notifications" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Admin email" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmailBox" Margin="0,2"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="EmailAlertsCheck"
                          Content="Enable email error notifications" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Google Chat webhook" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="GChatBox" Margin="0,2"
                             ToolTip="Leave blank to keep the existing value"/>
                <TextBlock Grid.Row="3" Text="Slack webhook" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="SlackBox" Margin="0,2"
                             ToolTip="Leave blank to keep the existing value"/>
            </Grid>
        </GroupBox>

        <DockPanel Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap" MaxWidth="300"
                       Text="Saving restarts the sync service so the new settings take effect — about 5 seconds."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; restart" Width="130" Click="Save_Click" Margin="0,0,8,0"
                        IsDefault="True"/>
                <Button Content="Cancel" Width="110" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
