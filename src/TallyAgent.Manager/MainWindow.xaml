<Window x:Class="TallyAgent.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tally BigQuery Agent — Management Console"
        Width="860" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Tally BigQuery Data Sync Agent" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>

        <!-- Status grid -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12"
                Background="#FAFAFA" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Service:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusValue}" x:Name="ServiceStatusText"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="Tally connection:"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource StatusValue}" x:Name="TallyStatusText"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Cloud API:"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusValue}" x:Name="CloudStatusText"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="Company:"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource StatusValue}" x:Name="CompanyText"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Last successful sync:"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValue}" x:Name="LastSyncText"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="Current activity:"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource StatusValue}" x:Name="ActivityText"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Pending batches:"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusValue}" x:Name="PendingText"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="Failed batches:"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource StatusValue}" x:Name="FailedText"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Uploaded today:"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusValue}" x:Name="AckedText"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource StatusLabel}" Text="Environment:"/>
                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource StatusValue}" x:Name="EnvironmentText"/>
            </Grid>
        </Border>

        <!-- Current run -->
        <Border Grid.Row="2" BorderBrush="#BFD9F7" BorderThickness="1" CornerRadius="6" Padding="12"
                Background="#F4F9FF" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Current run" FontWeight="Bold"/>
                    <TextBlock x:Name="RunStatusText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontWeight="Bold" Foreground="Gray" Text="idle"/>
                </DockPanel>
                <TextBlock x:Name="RunOperationText" Margin="0,6,0,0" FontSize="14"
                           TextTrimming="CharacterEllipsis" Text="Nothing running"/>
                <ProgressBar x:Name="RunProgressBar" Height="14" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="RunCountsText" Margin="0,6,0,0" Foreground="#333" Text=""/>
                <TextBlock x:Name="RunRangeText" Margin="0,2,0,0" Foreground="Gray"
                           TextTrimming="CharacterEllipsis" Text=""/>
            </StackPanel>
        </Border>

        <!-- Actions.  One primary button; everything that is rare, slow or
             destructive lives under Advanced.  "Sync Now (catch up)" sat one
             click away from "Re-extract Whole Range" - a one-minute job beside
             a seven-hour one, with nothing to tell them apart. -->
        <StackPanel Grid.Row="3" Margin="0,0,0,4">
            <WrapPanel>
                <Button x:Name="SyncNowBtn" Content="Sync Now" Click="SyncNow_Click"
                        FontWeight="Bold" Padding="18,7" Margin="0,0,10,6"
                        ToolTip="Runs a normal sync straight away: yesterday's changes plus the lookback window. Takes about a minute."/>
                <Button Content="Settings" Click="EditConfig_Click" Padding="12,7" Margin="0,0,10,6"/>
                <Button x:Name="TestTallyBtn" Content="Test Tally Connection" Click="TestTally_Click"
                        Padding="12,7" Margin="0,0,10,6"/>
                <Button x:Name="TestCloudBtn" Content="Test Cloud Connection" Click="TestCloud_Click"
                        Padding="12,7" Margin="0,0,10,6"/>
            </WrapPanel>

            <Expander Header="Advanced" Margin="0,2,0,0" Foreground="#555555">
                <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Margin="0,6,0,0"
                        Background="#FAFAFA">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="RestartBtn" Content="Restart Service" Click="RestartService_Click"
                                    Margin="0,0,8,6"/>
                            <Button x:Name="StartBtn" Content="Start Service" Click="StartService_Click"
                                    Margin="0,0,8,6"/>
                            <Button x:Name="StopBtn" Content="Stop Service" Click="StopService_Click"
                                    Margin="0,0,8,6"/>
                            <Button x:Name="RetryBtn" Content="Retry Failed Batches" Click="RetryFailed_Click"
                                    Margin="0,0,8,6"/>
                            <Button Content="Open Log Folder" Click="OpenLogs_Click" Margin="0,0,8,6"/>
                            <Button Content="Export Diagnostics" Click="ExportDiag_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <Separator Margin="0,6,0,8"/>

                        <Button x:Name="ForceFullBtn" Content="Re-extract All History…" Click="ForceFull_Click"
                                Foreground="#A4262C" HorizontalAlignment="Left" Padding="12,6"
                                ToolTip="Re-walks every financial year from the beginning."/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#A4262C"
                                   Text="Takes several hours and slows Tally the whole time. Only needed if data is found to be missing — a normal sync already keeps everything up to date."/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Recent errors -->
        <GroupBox Grid.Row="4" Header="Recent errors" Margin="0,4,0,8">
            <DataGrid x:Name="ErrorsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TsUtc}" Width="160"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="170"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="Dataset" Binding="{Binding Dataset}" Width="130"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="5">
            <TextBlock x:Name="FooterText" Foreground="Gray"
                       Text="Closing this window does not stop the sync service."/>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Hyperlink Click="Refresh_Click">Refresh</Hyperlink>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
