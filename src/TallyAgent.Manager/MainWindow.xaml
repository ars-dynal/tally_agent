<Window x:Class="TallyAgent.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tally BigQuery Agent" Height="820" Width="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="H">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- ── 1. IS IT HEALTHY?  One colour, one sentence. ────────────── -->
        <Border DockPanel.Dock="Top" x:Name="HealthBanner" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="1" Padding="14,11" CornerRadius="3">
            <StackPanel>
                <TextBlock x:Name="HealthText" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="Checking…"/>
                <TextBlock x:Name="HealthDetail" FontSize="11" Foreground="#555555"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── buttons ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="FooterText" FontSize="11"
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <WrapPanel>
                    <Button x:Name="SyncNowBtn" Click="SyncNow_Click" Padding="12,7" Margin="0,0,8,0"
                            Content="Sync now (incremental)"/>
                    <Button x:Name="FullResyncBtn" Click="FullResync_Click" Padding="12,7" Margin="0,0,8,0"
                            Foreground="#A4262C" Content="Full re-extract…"/>
                    <Button Content="Test Tally" Click="TestTally_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Test cloud" Click="TestCloud_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Settings…" Click="Config_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Logs" Click="Logs_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Diagnostics" Click="Diagnostics_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button x:Name="RetryBtn" Content="Retry failed uploads" Click="Retry_Click" Padding="12,7"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="0,12,0,0">

            <!-- ── 2. WHAT DID THE LAST RUN DO? ───────────────────────── -->
            <TabItem Header="Last run">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource H}" x:Name="LastRunHeading"
                               Text="Last run"/>
                    <TextBlock Grid.Row="1" x:Name="LastRunSummary" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,0,10"/>

                    <GroupBox Grid.Row="2" Header="Datasets that did NOT load" Padding="6">
                        <DataGrid x:Name="FailedGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dataset" Binding="{Binding Dataset}" Width="200"/>
                                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <TextBlock Grid.Row="3" x:Name="NoFailuresText" Margin="0,6,0,0"
                               FontSize="11" Foreground="#107C10" Visibility="Collapsed"
                               Text="Every dataset loaded."/>

                    <TextBlock Grid.Row="4" x:Name="ProgressText" Margin="0,10,0,0"
                               FontSize="11" Foreground="#555555" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ── 3. WHAT HAS BEEN SENT TO THE CLOUD? ────────────────── -->
            <TabItem Header="Sent to cloud">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource H}"
                               Text="What this agent has handed to the ingestion API"/>
                    <DataGrid Grid.Row="1" x:Name="DeliveryGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dataset" Binding="{Binding Dataset}" Width="190"/>
                            <DataGridTextColumn Header="Records accepted" Binding="{Binding Accepted}" Width="120"/>
                            <DataGridTextColumn Header="Waiting to send" Binding="{Binding Pending}" Width="110"/>
                            <DataGridTextColumn Header="Stuck" Binding="{Binding Failed}" Width="70"/>
                            <DataGridTextColumn Header="Last accepted" Binding="{Binding LastAccepted}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── 4. RUN HISTORY ─────────────────────────────────────── -->
            <TabItem Header="Run history">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource H}"
                               Text="Last 20 runs — successful ones included, so you can tell whether last night worked"/>
                    <DataGrid Grid.Row="1" x:Name="HistoryGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="140"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/>
                            <DataGridTextColumn Header="Window" Binding="{Binding Window}" Width="180"/>
                            <DataGridTextColumn Header="Datasets" Binding="{Binding Datasets}" Width="80"/>
                            <DataGridTextColumn Header="Records" Binding="{Binding Records}" Width="90"/>
                            <DataGridTextColumn Header="Took" Binding="{Binding Duration}" Width="70"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── errors, in plain language ──────────────────────────── -->
            <TabItem Header="Problems">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource H}"
                               Text="Recent problems, with what to do about each"/>
                    <DataGrid Grid.Row="1" x:Name="ErrorGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130"/>
                            <DataGridTextColumn Header="What happened" Binding="{Binding What}" Width="330"/>
                            <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
